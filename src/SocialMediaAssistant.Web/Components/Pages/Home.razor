@page "/"

<PageTitle>Social Media Assistant</PageTitle>

<div class="p-4 mb-4 bg-light border rounded-3">
    <div class="container-fluid py-2">
        <h1 class="display-6">🤖 Social Media Assistant</h1>
        <p class="lead">Production-ready .NET 9 scaffold for AI-assisted Instagram, Facebook, and WhatsApp commerce.</p>
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-primary" href="dashboard">Open Dashboard</a>
            <a class="btn btn-outline-secondary" href="products">View Products</a>
            <a class="btn btn-outline-secondary" href="inbox">Open Inbox</a>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Unified inbox</h5>
                <p class="card-text">Review AI-handled conversations across Instagram, Facebook, and WhatsApp from one dashboard.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Stock-aware replies</h5>
                <p class="card-text">Ground AI responses in live product inventory so assistants only promise what sellers can fulfill.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">SaaS-ready foundation</h5>
                <p class="card-text">Clean layered architecture, Azure AD B2C auth hooks, PostgreSQL persistence, and Redis integration points.</p>
            </div>
        </div>
    </div>
</div>
